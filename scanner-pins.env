# Scanner binaries this library downloads, pinned by release and by the sha256
# of each release archive. The install steps check an archive against the
# value here, never against a checksums file fetched beside it: a replaced
# release brings its own checksums.
#
# Read with scripts/install_trivy.sh, scripts/install_gitleaks.sh and
# scripts/install_foxguard.sh. At the
# repository root so that a cone-mode sparse checkout of the library (the
# reusable workflows check out `scripts` and `.github/actions` at
# `job.workflow_sha`) always carries it.
#
# Digests, when written: the release's checksums file, GitHub's asset digest
# and a local sha256 of the downloaded archive, all equal. Trivy's checksums
# file is also cosign-verified (keyless, release workflow of the tag).

# https://github.com/aquasecurity/trivy/releases/tag/v0.76.2 (2026-11-05)
TRIVY_VERSION=0.76.2
TRIVY_SHA256_LINUX_64BIT=bc0fc726e017b8927a62b2d3531d7a84ee01769daf5c99ed866dced54089fdbf
TRIVY_SHA256_LINUX_ARM64=ab9d51f86e6a5fb936f605faff6b593ac51bc378fff4d3e8b9d58358b9c367c3
TRIVY_SHA256_MACOS_64BIT=e08bb9ea449ecf66c6bfb03cbb8697c503ff33d35fc585c9747e3eaeb7ed4c7b
TRIVY_SHA256_MACOS_ARM64=ae7ea358326960406b703c77b2ac490190797d80b306b5b50c2a27221da0a5b8

# https://github.com/gitleaks/gitleaks/releases/tag/v8.30.1
GITLEAKS_VERSION=8.30.1
GITLEAKS_SHA256_LINUX_X64=551f6fc83ea457d62a0d98237cbad105af8d557003051f41f3e7ca7b3f2470eb
GITLEAKS_SHA256_LINUX_ARM64=e4a487ee7ccd7d3a7f7ec08657610aa3606637dab924210b3aee62570fb4b080
GITLEAKS_SHA256_DARWIN_X64=dfe101a4db2255fc85120ac7f3d25e4342c3c20cf749f2c20a18081af1952709
GITLEAKS_SHA256_DARWIN_ARM64=b40ab0ae55c505963e365f271a8d3846efbc170aa17f2607f13df610a9aeb6a5
GITLEAKS_SHA256_WINDOWS_X64=d29144deff3a68aa93ced33dddf84b7fdc26070add4aa0f4513094c8332afc4e
GITLEAKS_SHA256_WINDOWS_ARM64=b95f5e4f5c425cedca7ee203d9afd29597e692c4924a12ed42f970537c72cc0f

# https://github.com/0sec-labs/foxguard/releases/tag/v0.14.1
# Bare binaries, one per platform; digests from the release's checksums.txt,
# equal to GitHub's asset digests. No Windows arm64 binary is published.
FOXGUARD_VERSION=0.14.1
FOXGUARD_SHA256_LINUX_X86_64=10a531279f7f3e9dcd01996e5e288309cd6d7d2bb2b7fa35de583d0bbe715bc2
FOXGUARD_SHA256_LINUX_AARCH64=f374bb1b81ffcb01aa5446719dee199245c673fffc9c659e985bbabe0faaa032
FOXGUARD_SHA256_MACOS_X86_64=df78bc22307b893975c4d75799b36a1d7f1664be92aeeab19e61b7d0ecfafa26
FOXGUARD_SHA256_MACOS_AARCH64=e466cb4692a959fb500cd9f55d35aac0dd530afce8358643ed186e2c8c85f8c5
FOXGUARD_SHA256_WINDOWS_X86_64=0fb139cb088a302a2c6567087079c4152025c20ac0e06a64107e9a0382e4bffb

# gosec is built from source with `go install`; the Go module checksum
# database verifies the module, so a version is the whole pin.
# https://github.com/securego/gosec/releases/tag/v2.30.0
GOSEC_VERSION=v2.30.0
