#!/usr/bin/env bash
set -euo pipefail

repo_root="$(git rev-parse --show-toplevel 2>/dev/null || true)"
if [[ -z "$repo_root" ]]; then
  exit 0
fi

"$repo_root/scripts/check_release_version.sh" --repo "$repo_root"

# Every workflow and composite action here is consumed by other
# repositories, so one that does not parse is a broken release for anyone
# pinned to it. Catching that at commit time is cheaper than in CI, and
# cheaper still than after a release -- wp-plugin-check/action.yml shipped
# invalid and nothing noticed.
python3 "$repo_root/scripts/check_workflow_yaml.py"

# An input the engine declares is useless to a caller that goes through a preset
# unless every hop forwards it. actionlint catches the opposite mistake -- a
# preset passing an input the engine does not declare -- and nothing caught this
# one, which is how timeout_minutes ended up honoured by 2 of 13 presets.
python3 "$repo_root/scripts/check_engine_inputs.py"

# Release notes are cut from one CHANGELOG section. A second `## Unreleased`
# above an existing one drops everything under the lower heading, silently,
# while the file still appears to contain it -- which happened on 2026-09-21
# and was caught by re-reading the file rather than by any check.
python3 "$repo_root/scripts/check_changelog_structure.py"

# A notice, never a gate. vendor-check.yml deliberately does not test currency
# -- an upstream release would turn every open pull request red for a reason
# unrelated to the change under review -- and the same reasoning applies to a
# commit. This only says that script-helpers has moved on; it is throttled to
# once a day, silent when current, silent offline, and cannot fail the commit.
# Run `./scripts/check_vendor_currency.sh --offer` to act on it.
"$repo_root/scripts/check_vendor_currency.sh" || true
