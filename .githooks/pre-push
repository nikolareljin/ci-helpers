#!/usr/bin/env bash
# Mandatory local checks run before Git records or transports repository data.
set -uo pipefail
root="$(git rev-parse --show-toplevel)" || exit 1
cd "$root" || exit 1
library="$root/vendor/script-helpers/scripts/security_hooks.sh"
[[ -f "$library" ]] || { echo 'Security check unavailable; reinstall the vendored hooks.' >&2; exit 1; }
# shellcheck source=/dev/null
source "$library" || exit 1
umask 077
scratch="$(mktemp -d)" || exit 1
trap 'rm -rf "$scratch"' EXIT
cat > "$scratch/refs" || exit 1
sec_pre_push "$scratch/refs" "${1:-}" "${2:-}"
