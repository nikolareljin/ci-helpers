# Vendor dependencies
vendor/
!vendor/.script-helpers-sha
!vendor/.script-helpers-ref
!vendor/.script-helpers-notes.md

# IDE files
.vscode/
.idea/

# OS files
.DS_Store
Thumbs.db

# Python bytecode caches (created when a script is imported, e.g. in tests)
__pycache__/
*.pyc

# Temporary files
*.tmp
*.bak
*~
TODO.txt
/ignore/

# Ignore Claude memory files outside the repo root
CLAUDE.md
!/CLAUDE.md

# MkDocs documentation site build output.
# The toolchain virtualenv lives in the user cache by default (see
# scripts/docs_site.sh); this covers the case where DOCS_VENV points it back
# into the tree. Anchored to the root so it cannot shadow anything vendored.
/site/
/.cache/
/.venv-docs/

# Godot builds the script class cache next to the fixture project on import.
.godot/

# Written by tests/fixtures/django-app/manage.py when the drift check runs.
.fixture-makemigrations-ran

# `composer install` in the PHP fixtures, which the audit legs run. The lock
# file is deliberately absent from the tree: the fixture stands in for a lock
# written while its packages were clean, and committing one would pin the
# advisory set to whatever it was on the day it was generated.
/tests/fixtures/php-vuln/vendor/
/tests/fixtures/php-vuln/composer.lock
/tests/fixtures/php-clean/vendor/
/tests/fixtures/php-clean/composer.lock

# pip build output from the django-install fixture (self-test-web.yml)
tests/fixtures/django-install/probe/build/
*.egg-info/
