# Compiler and SDK installers this library downloads, pinned by release and
# by the sha256 of each installer. The install steps check a download against
# the value here, never against a checksums file fetched beside it.
#
# Read with scripts/setup_rust.sh, scripts/setup_godot.sh and
# scripts/setup_flutter.sh. At the repository root, like scanner-pins.env, so
# that a cone-mode sparse checkout of the library (the reusable workflows
# check out `scripts` at `job.workflow_sha`) always carries it.
#
# GitHub-hosted runners ship rustup, so the Rust pins are read only on a
# runner without it (self-hosted). Digests, when written: the `.sha256` file
# published beside each installer on static.rust-lang.org and a local sha256
# of the downloaded file, equal.

# https://github.com/rust-lang/rustup/releases/tag/1.29.3
# https://static.rust-lang.org/rustup/archive/1.29.3/<target>/rustup-init[.exe]
RUSTUP_VERSION=1.29.3
RUSTUP_INIT_SHA256_X86_64_UNKNOWN_LINUX_GNU=b1c8cb14e30889e7e2999e6b69e62d9e9b9ffc0f4df8180564d306d9680e6c55
RUSTUP_INIT_SHA256_AARCH64_UNKNOWN_LINUX_GNU=9f608c142e0e38a78957d0661ba1dfaf0b6fb37184cfaa4b9a0aa57af6184282
RUSTUP_INIT_SHA256_X86_64_APPLE_DARWIN=bc107f1fb0228de7fa32413c89c1b305cea9cd256e94b01150cd054128145429
RUSTUP_INIT_SHA256_AARCH64_APPLE_DARWIN=63752a1919a3a4793173ec70f8f212621a7ce38ba6a246095984482f4de20f9f
RUSTUP_INIT_SHA256_X86_64_PC_WINDOWS_MSVC=38027d51d69a5d05493627a0634dbea52d6cd793c8f072d2373d3f4163eec7db
RUSTUP_INIT_SHA256_AARCH64_PC_WINDOWS_MSVC=407e0d72f81d26a01f9d032b8317908cbb2917ba22765474b682b41390792ad9

# Container images the multi-arch Docker build runs, pinned by tag and by the
# digest of the image index (every platform). Read with scripts/setup_qemu.sh
# and scripts/setup_buildx.sh.
#
# binfmt: the image the replaced QEMU setup action pulled by default
# (docker.io/tonistiigi/binfmt:latest), resolved on 2026-11-09 to the
# qemu-v10.2.3 release; `docker buildx imagetools inspect` and Docker Hub's
# tag listing give the same index digest.
# https://github.com/tonistiigi/binfmt/releases/tag/qemu-v10.2.3
BINFMT_IMAGE=docker.io/tonistiigi/binfmt:qemu-v10.2.3@sha256:400a4873b838d1b89194d982c45e5fb3cda4593fbfd7e08a02e76b03b21166f0

# BuildKit: the image buildx pulls for a docker-container builder by default
# (docker.io/moby/buildkit:buildx-stable-1), resolved on 2026-11-09 to the
# v0.34.2 release; same two sources, same index digest.
# https://github.com/moby/buildkit/releases/tag/v0.34.2
BUILDKIT_IMAGE=docker.io/moby/buildkit:v0.34.2@sha256:c5f8862f52499773af85bc07695b2379ef08e8002352b0df2c4864c91d78dabe

# fastlane, installed as a gem by flutter-release.yml when the caller has no
# Gemfile (a Gemfile.lock pins its own). `gem install` checks no digest, and
# fastlane is not signed, so a trust policy would refuse it: the pin is the
# version only, fetched from rubygems.org over TLS, and its dependencies
# resolve to their newest compatible releases. A caller that needs digests
# commits a Gemfile.lock with a CHECKSUMS section (Bundler 2.6).
# https://rubygems.org/gems/fastlane/versions/2.241.2
FASTLANE_VERSION=2.241.2

# Godot editor archives from the official release repository, one digest per
# release, variant and platform, read with scripts/setup_godot.sh. A release
# with no entry here is refused before anything is downloaded. Digests:
# the SHA512-SUMS.txt published with each release on
# github.com/godotengine/godot-builds matched the downloaded archives
# (`sha512sum -c`), and the sha256 of each verified archive is what is
# written here. Key: GODOT_SHA256_<release with . as _>_<archive suffix,
# upper case, . as _>; the release is the tag (4.3.0 is 4.3-stable, as the
# replaced action named it).
#
# https://github.com/godotengine/godot-builds/releases/tag/4.3-stable
# https://github.com/godotengine/godot-builds/releases/download/4.3-stable/Godot_v4.3-stable_<suffix>.zip
GODOT_SHA256_4_3_STABLE_LINUX_X86_64=7de56444b130b10af84d19c7e0cf63cf9e9937ee4ba94364c3b7dd114253ca21
GODOT_SHA256_4_3_STABLE_MONO_LINUX_X86_64=ecdf3cd5a6004a6568c199581d58ba685a9905926e51677906b76fbdd9cad351
GODOT_SHA256_4_3_STABLE_MACOS_UNIVERSAL=d17940b913b3f3bf54c941eeb09042099d93865c6e2638e09e20f7c649aa474a
GODOT_SHA256_4_3_STABLE_MONO_MACOS_UNIVERSAL=115ec67929a5e9a55cba1b4f578ddf8cfc6003e2eb1406e5a484d63ab53b03b7
GODOT_SHA256_4_3_STABLE_WIN64_EXE=8f2c75b734bd956027ae3ca92c41f78b5d5a255dacc0f20e4e3c523c545ad410
GODOT_SHA256_4_3_STABLE_MONO_WIN64=63a214acefed9a2df6c2beb0808ad0b4cfbc306ac5b4aacb7dcb33c344330006
# https://github.com/godotengine/godot-builds/releases/tag/4.7.2-stable
GODOT_SHA256_4_7_2_STABLE_LINUX_X86_64=cadd3204e728a35d3f13adb7fd0d7902636b79f6b95c40c265eb73b6c35329e4
GODOT_SHA256_4_7_2_STABLE_MONO_LINUX_X86_64=129f82db7bafd54ae14bb5bb284041c73860e8c7a009a3a026ca5e946cbff247
GODOT_SHA256_4_7_2_STABLE_MACOS_UNIVERSAL=c58a24e31d720be9d62f60cb5627c4e695fb72f21b0cfe1bc9ccaa9a3b3ba63e
GODOT_SHA256_4_7_2_STABLE_MONO_MACOS_UNIVERSAL=8af3977b60d2c59802f7c8ff1914b3ca02a5e294f7381fc1104ee777e33cbbd8
GODOT_SHA256_4_7_2_STABLE_WIN64_EXE=731980f9608d61333e5baf54a2ef17210acc7a538446c0cb9969f002aca1e953
GODOT_SHA256_4_7_2_STABLE_MONO_WIN64=a2a48473a7414c5f19fab690518caebb738c09ef9601f6bd2388676a7f53b3c0

# Flutter SDK, read with scripts/setup_flutter.sh. The release manifest
# (storage.googleapis.com/flutter_infra_release/releases/releases_<os>.json)
# carries a sha256 per archive and every download is checked against it;
# the release below is what an empty flutter_version on the stable channel
# installs, and its digests must also match the manifest's, so a manifest
# that changes under a published release refuses. Digests: the manifest
# entries for 3.47.9 (hash c197ca5199e9ee5661e865596c9c07294dfab51c) read
# on 2026-11-09; the linux archive was downloaded and its sha256 matched.
# https://storage.googleapis.com/flutter_infra_release/releases/stable/linux/flutter_linux_3.47.9-stable.tar.xz
FLUTTER_VERSION=3.47.9
FLUTTER_SHA256_LINUX_X64=25ed8c3c29d51a7353f2a944310b478af8214920639524b19c50a19e6c044c5a
FLUTTER_SHA256_MACOS_X64=0dc38b4038a0b002a6258696a5b327a58473c175c9e334b9f329ef7d79a4fdcd
FLUTTER_SHA256_MACOS_ARM64=6545b85938745dc5070e9faf2adf70233c1811009d87fe6d27bfcda5a04b7698
FLUTTER_SHA256_WINDOWS_X64=d8e2b5977e09082c6440f89dc1aa887b94c8fbcc3b39222797046295a3f68a9e

# Unity editor images unity.yml runs a project's tests in, one line per
# editor version, pinned by tag and index digest. Read with
# scripts/unity_test.sh, which takes the version from the project's
# ProjectSettings/ProjectVersion.txt (or unity_version) and looks up
# UNITY_EDITOR_IMAGE_<version with dots as underscores>. The tag is the one
# the replaced action built for a Linux runner, ubuntu-<version>-linux-il2cpp-3
# (-base-3 before Unity 2019.3). A version with no line here is refused with
# the line to add: resolve the digest with
#   docker buildx imagetools inspect docker.io/unityci/editor:ubuntu-<version>-linux-il2cpp-3
# and Docker Hub's tag page, and add it when both agree. The tag is rebuilt
# by its publisher now and then (6000.0.23f1 was, on 2026-04-02); the digest
# below names one build.
#
# 6000.0.23f1: resolved on 2026-11-09, both sources the same index digest.
UNITY_EDITOR_IMAGE_6000_0_23f1=docker.io/unityci/editor:ubuntu-6000.0.23f1-linux-il2cpp-3@sha256:bbf2c7a85ecd19a68dbbfd5053736edbe3cd4593bbc63629b85a0b1cce87653d
