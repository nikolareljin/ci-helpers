#!/usr/bin/env bash
# pre-push hook: block a push on what must not leave the machine, fast.
#   1. security: private names, credentials and PII in the pushed commits
#   2. hygiene:  conflict markers, large or secret-looking files, AI trailers,
#                release CHANGELOG and VERSION
#   3. lint:     syntax and lint of the files the push changes
# Tests do not run on push unless the repository opts in (git config
# script-helpers.push-tests quick): the full suite is `make test` or `./dev test`
# (or scripts/run_repo_tests.sh). Every check runs to the end; a large or
# first push takes longer, and that is fine.
# Install via: git config core.hooksPath scripts/git-hooks
#              or: bash scripts/setup-hooks.sh
#              or from a submodule: bash scripts/script-helpers/scripts/setup-hooks.sh
#
# Skip with: git push --no-verify  (skips every check, the private-name one too)
#
# git connects to the remote before this hook runs and keeps the connection open,
# idle, until it passes. Over SSH a long run can be cut off by the server
# (push exits 141, "Connection to <host> closed by remote host"). The hook says so
# before the checks start when no SSH keepalive is set, with the ways to set one
# (scripts/ssh_keepalive.sh).
set -euo pipefail

_push_url="${2:-}"   # git passes the remote name and URL

repo_root="$(git rev-parse --show-toplevel 2>/dev/null || pwd)"
cd "$repo_root"

# A push that only deletes refs adds no commits, so there is nothing to check.
# Checking anyway is pure latency, and it is the kind of latency that teaches
# people to reach for --no-verify: pruning three merged branches otherwise runs
# the full gate three times, once per deletion.
#
# Deliberately conservative. The gate is skipped only when EVERY ref in this
# push is a deletion; one added ref alongside them and the checks run as usual.
# Zeroes are matched as a pattern rather than compared with a 40-character
# constant, because a SHA-256 repository writes 64 of them.
_push_is_deletions_only() {
  local lref lsha rref rsha saw_ref=false
  # git feeds four fields per ref. Three are unread, but all four must be
  # consumed positionally or the shas land in the wrong variables.
  # shellcheck disable=SC2034
  while read -r lref lsha rref rsha; do
    [[ -n "${lsha:-}" ]] || continue
    saw_ref=true
    [[ "$lsha" =~ ^0+$ ]] || return 1
  done
  [[ "$saw_ref" == "true" ]]
}

# A push whose every ref line has the same local and remote sha sends nothing.
# No ref lines at all (an up-to-date or rejected push, or a wrapper that lost
# git's stdin) is not decided here: see sec_push_head_line below.
_push_sends_nothing() {
  local lref lsha rref rsha saw=false
  # shellcheck disable=SC2034
  while read -r lref lsha rref rsha; do
    [[ -n "${lref:-}" ]] || continue                     # a blank line
    # Anything that is not a well-formed ref line goes to the checks, which
    # refuse what they cannot read.
    [[ "${lsha:-}" =~ ^[0-9a-f]{40,64}$ && "$lsha" == "${rsha:-}" ]] || return 1
    saw=true
  done
  [[ "$saw" == true ]]
}

# git feeds the ref lines on stdin, and they can only be read once. They are
# needed twice -- for the deletions-only shortcut and to work out which commits
# are actually going out -- so they are captured first.
# In a private per-run directory (mktemp -d, mode 700); refused when it cannot
# be made, since an empty path would read no refs and skip every check.
_push_tmp="$(mktemp -d "${TMPDIR:-/tmp}/pre-push.XXXXXX" 2>/dev/null)" && [[ -n "$_push_tmp" && -d "$_push_tmp" && ! -L "$_push_tmp" ]] || {
  echo "[pre-push] could not create a private temp directory; refused." >&2
  exit 1
}
chmod 700 "$_push_tmp" 2>/dev/null || true
_push_refs="$_push_tmp/refs"
_check_refs="$_push_refs"
# Guarded: a subshell inherits an EXIT trap, and bash runs it there when the
# subshell is signalled -- so this could tear down the caller's stack, or
# delete a directory, while the run is still using it. ${BASHPID-$$} rather
# than $BASHPID alone: bash 3.2, which macOS ships, does not define BASHPID,
# and $$ is the top-level shell's pid in every subshell, so the comparison
# degrades to always-true there rather than to always-false.
trap 'if [[ ${BASHPID-$$} == "$$" ]]; then rm -rf "$_push_tmp"; fi' EXIT
cat > "$_push_refs" || { echo "[pre-push] could not read the ref lines; refused." >&2; exit 1; }

if _push_is_deletions_only < "$_push_refs"; then
  echo "[pre-push] deletions only — no new commits to check."
  exit 0
fi
if _push_sends_nothing < "$_push_refs"; then
  echo "[pre-push] no ref to update; nothing to check."
  exit 0
fi

# Security steps, before anything else and before a repository's own hook:
# private names (block) -> credentials, personal identifiers, PII (block) ->
# foxguard (warnings only). See scripts/security_hooks.sh.
_hook_dir="$(cd "$(dirname "${BASH_SOURCE[0]}")" && pwd)"
# Before the checks, while it can still help: an SSH push idle during long
# checks is cut off after they pass.
if [[ -f "$_hook_dir/../ssh_keepalive.sh" ]]; then
  # shellcheck source=/dev/null
  source "$_hook_dir/../ssh_keepalive.sh" && ssh_keepalive_note "$_push_url" "[pre-push]"
fi
# The once-per-push marker is for this hook's own note (the dispatcher may have
# shown it already); a repository's own pre-push must not inherit it, or a test
# of the note run from there sees it suppressed and fails the push.
unset SCRIPT_HELPERS_SSH_NOTE_SHOWN
_security_lib=""
for _candidate in "$_hook_dir/../security_hooks.sh" "${SCRIPT_HELPERS_SECURITY_DIR:-/nonexistent}/security_hooks.sh"; do
  [[ -f "$_candidate" ]] && { _security_lib="$_candidate"; break; }
done
if [[ -n "$_security_lib" ]]; then
  # shellcheck source=/dev/null
  source "$_security_lib"
  # The checks read _check_refs; the repository's own hook below still gets
  # exactly what git sent (_push_refs).
  if ! grep -q '[^[:space:]]' "$_push_refs"; then
    _check_refs="$_push_tmp/check-refs"
    sec_push_head_line "${1:-}" > "$_check_refs"
    if [[ ! -s "$_check_refs" ]]; then
      echo "[pre-push] no ref to update; nothing to check."
      exit 0
    fi
    echo "[pre-push] git sent no ref lines; checking HEAD's commits that the remote does not have."
  fi
  if ! sec_pre_push "$_check_refs" "${1:-}" "${2:-}"; then
    exit 1
  fi
else
  # A check that cannot run is not a clean one.
  if [[ "${SECURITY_GATE_ALLOW_UNCHECKED:-${SENSITIVE_ALLOW_UNCHECKED:-}}" == 1 ]]; then
    echo "[pre-push] WARNING: security_hooks.sh not found next to this hook; SECURITY_GATE_ALLOW_UNCHECKED=1, security checks skipped." >&2
  else
    echo "[pre-push] security_hooks.sh not found next to this hook; security checks cannot run; refused." >&2
    echo "[pre-push] Reinstall the hooks, or push once with SECURITY_GATE_ALLOW_UNCHECKED=1." >&2
    exit 1
  fi
fi

# Hygiene and lint of what the push changes (scripts/push_checks.sh). Not
# twice: the global dispatcher, when it chains to this hook, has run them for
# this very push (the hash of these ref lines; any other value is ignored).
_push_hash="$(git hash-object --stdin < "$_check_refs" 2>/dev/null || true)"
if [[ -n "$_push_hash" && "${SCRIPT_HELPERS_PUSH_CHECKED:-}" == "$_push_hash" ]]; then
  echo "[pre-push] hygiene, lint (and opted-in tests): already run for this push by the global hooks."
elif [[ -n "$_security_lib" && -f "$(dirname "$_security_lib")/push_checks.sh" ]]; then
  # shellcheck source=/dev/null
  source "$(dirname "$_security_lib")/push_checks.sh"
  push_checks "$_check_refs" "${1:-}" "${2:-}" || exit 1
  push_tests || exit 1
else
  # Opted in, but the runner is not here: refuse rather than skip the tests.
  # (case, not =~: bash 3.2's regex has no empty alternative.)
  case "$(git config --get script-helpers.push-tests 2>/dev/null || true)" in
    ""|off|false) ;;
    *)
      echo "[pre-push] REFUSED: script-helpers.push-tests is set, but push_checks.sh is not next to this hook; reinstall the hooks." >&2
      exit 1 ;;
  esac
fi
unset SCRIPT_HELPERS_PUSH_CHECKED

# A repo-local pre-push hook runs last, after every check above. It gets the
# ref lines git gave this hook, and its exit is the push's.
# -ef guard: skip when it is this very file (avoids infinite recursion).
if [[ -f .githooks/pre-push ]] && ! [[ .githooks/pre-push -ef "$0" ]]; then
  _local_rc=0
  bash .githooks/pre-push "$@" < "$_push_refs" || _local_rc=$?
  exit "$_local_rc"
fi

if [[ -n "${PRE_PUSH_SKIP_TESTS:-}" ]]; then
  echo "[pre-push] PRE_PUSH_SKIP_TESTS is ignored: a push runs tests only with git config script-helpers.push-tests quick."
fi
if [[ "$(git config --get script-helpers.push-tests 2>/dev/null || true)" == quick ]]; then
  echo "[pre-push] All checks passed."
else
  echo "[pre-push] All checks passed. Tests are not run on push: make test or ./dev test."
fi
