#!/usr/bin/env bash
# commit-msg hook: refuse a message that names a private repository or carries sensitive data.
# Install via: git config core.hooksPath scripts/git-hooks
#              or: bash scripts/setup-hooks.sh
#
# Skip with: git commit --no-verify
#
# This is a commit-msg hook and not part of pre-commit because a pre-commit hook
# runs before the message exists and cannot see it. The message is the surface
# that matters: a name in a commit message is published the moment the branch is
# pushed, and rewriting it afterwards changes every tag that points at it.
set -euo pipefail

msg_file="${1:?commit-msg hook needs the message file}"
repo_root="$(git rev-parse --show-toplevel 2>/dev/null || pwd)"
cd "$repo_root"

_hook_dir="$(cd "$(dirname "${BASH_SOURCE[0]}")" && pwd)"
_security_lib="$_hook_dir/../security_hooks.sh"
if [[ -f "$_security_lib" ]]; then
  # shellcheck source=/dev/null
  source "$_security_lib"
  set +e
  sec_commit_msg "$msg_file" || exit 1
  set -e
else
  # The repo-local hook below still runs; the push refuses until it is found.
  echo "[commit-msg] security_hooks.sh not found next to this hook; checks skipped." >&2
fi

# A repo-local hook replaces the rest, after the checks above, as in pre-push.
if [[ -f .githooks/commit-msg ]] && ! [[ .githooks/commit-msg -ef "$0" ]]; then
  exec bash .githooks/commit-msg "$@"
fi
exit 0
